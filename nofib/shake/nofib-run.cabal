cabal-version:       2.2
name:                nofib
version:             0.1.0.0
-- synopsis:
-- description:
-- bug-reports:
license:             BSD-3-Clause
license-file:        LICENSE
author:              Ben Gamari
maintainer:          ben@smart-cactus.org
-- copyright:
-- category:
build-type:          Simple

common shared-settings
  ghc-options: -Wall -Wno-x-partial
  default-extensions: ScopedTypeVariables

library
  import: shared-settings
  exposed-modules:     Measurements
  ghc-options:
  hs-source-dirs:      src
  build-depends:       base,
                       aeson,
                       these >= 0.8,
                       containers,
                       cassava,
                       text,
                       filepath,
                       vector,
                       bytestring
  default-language:    Haskell2010

executable nofib-run
  import: shared-settings
  main-is:             Main.hs
  ghc-options:         -threaded
  hs-source-dirs:      runner
  other-modules:
      CachegrindParse
    , PerfStatParse
    , ParseResults
    , RunnerTypes
    , Utils
  other-extensions:
      RecordWildCards
    , DeriveDataTypeable
    , BangPatterns
    , ScopedTypeVariables
  build-depends:       base,
                       time >=1.4 && <1.17,
                       containers,
                       bytestring,
                       directory >=1.1 && <1.4,
                       filepath,
                       process >=1.3 && <1.7,
                       text,
                       optparse-applicative,
                       shake >= 0.16 && < 0.20 && ( > 0.18.2 || < 0.18),
                       nofib,
                       deepseq
  default-language:    Haskell2010

executable nofib-compare
  import: shared-settings
  main-is:             Compare.hs
  hs-source-dirs:      compare
  ghc-options:         -threaded
  other-modules:       LabelMatch
  other-extensions:    RecordWildCards, DeriveDataTypeable
  build-depends:       base,
                       these,
                       containers,
                       directory,
                       filepath,
                       text,
                       aeson,
                       ansi-wl-pprint,
                       tabular >= 0.2.2.8,
                       these,
                       semialign,
                       optparse-applicative,
                       ansi-terminal,
                       nofib
  default-language:    Haskell2010

executable nofib-merge
  import: shared-settings
  main-is:             Merge.hs
  ghc-options:         -threaded
  build-depends:       base,
                       optparse-applicative,
                       cassava,
                       bytestring,
                       nofib
  default-language:    Haskell2010
